{
	"name": "win10ml",
	"version": "0.4.0",
	"description": "Framework-agnostic Windows 10 desktop HUD for the web (WinML): draggable windows, taskbar with Start button and pinned apps, menus, controls, calendar, message boxes and markdown. Zero dependencies, pure DOM.",
	"license": "GPL-3.0-only",
	"author": {
		"name": "Kisakay",
		"url": "https://github.com/Kisakay"
	},
	"homepage": "https://github.com/Kisakay/winml",
	"repository": {
		"type": "git",
		"url": "git@github.com:Kisakay/winml.git"
	},
	"keywords": [
		"windows-10",
		"desktop",
		"taskbar",
		"window-manager",
		"hud",
		"ui",
		"zero-dependency",
		"vanilla-js"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./style.css": "./dist/win10-shell.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"styles",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"clean": "rm -rf dist demo/dist",
		"build:js": "esbuild src/index.ts --bundle --minify --format=esm --outfile=dist/index.js && esbuild src/index.ts --bundle --minify --format=cjs --outfile=dist/index.cjs",
		"build:dts": "tsc -p tsconfig.json",
		"build:css": "mkdir -p dist && cp styles/win10-shell.css dist/win10-shell.css",
		"build:demo": "mkdir -p demo/dist && node ./scripts/build-demo.mjs && cp styles/win10-shell.css demo/dist/win10-shell.css",
		"build:pages": "npm run build && node ./scripts/build-pages.mjs",
		"build": "npm run clean && npm run build:js && npm run build:dts && npm run build:css && npm run build:demo",
		"prepublishOnly": "npm run build",
		"dev": "node ./scripts/dev.mjs",
		"demo": "npm run build:demo && npx http-server ./demo -p 8080 -c-1"
	},
	"devDependencies": {
		"@noble/post-quantum": "^0.7.1",
		"esbuild": "^0.27.2",
		"qxchat.ts": "^1.3.0",
		"typescript": "^5.9.3"
	}
}
